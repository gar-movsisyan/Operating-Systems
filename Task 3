#include <stdio.h>

// 1. Method to swap two integers using pointers
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int main() {
    int x = 10;
    int y = 20;

    // 3. before swap
    printf("Before swap: x = %d, y = %d\n", x, y);

    // 2. Pass the addresses of x and y
    swap(&x, &y);

    // after swap
    printf("After swap:  x = %d, y = %d\n", x, y);
    return 0;
}
